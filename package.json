{
  "name": "mcd-codeburger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CodeBurger · 麦门人格汉堡工厂 — Feed Your Agent.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/persona.test.mjs tests/mcd-parse.test.mjs",
    "gate:a": "node --experimental-strip-types scripts/gate-a-probe.mjs",
    "mockups": "node --experimental-strip-types scripts/build-mockups.mjs",
    "brief": "node --experimental-strip-types scripts/build-art-brief.mjs",
    "review": "node --experimental-strip-types scripts/build-art-review.mjs",
    "art:meta": "node --experimental-strip-types scripts/export-art-meta.mjs",
    "art:prep": "node --experimental-strip-types scripts/export-art-meta.mjs && python scripts/prep-art.py",
    "shot": "node scripts/shot-mockups.mjs",
    "snapshot": "node scripts/snapshot-mcd.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
